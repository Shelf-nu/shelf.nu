{
  "name": "@shelf/quantity-control",
  "version": "0.0.0",
  "private": true,
  "description": "Pure, dependency-free quantity/availability domain for QUANTITY_TRACKED assets, shared by the webapp and the companion app so their availability math never drifts.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test",
    "prepare": "tsc -p tsconfig.build.json"
  },
  "devDependencies": {
    "@shelf/typescript-config": "workspace:*",
    "@types/node": "^22.19.17",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  }
}
