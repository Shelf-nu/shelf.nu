{
  "expo": {
    "name": "Shelf",
    "slug": "shelf-companion",
    "version": "1.5.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "shelf",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.shelf.companion",
      "associatedDomains": ["applinks:app.shelf.nu"],
      "infoPlist": {
        "NSCameraUsageDescription": "Shelf needs camera access to scan QR codes and barcodes on your assets.",
        "NSPhotoLibraryUsageDescription": "Shelf needs photo library access so you can attach photos to assets and audits.",
        "NSLocationWhenInUseUsageDescription": "Shelf records where assets were scanned so your team can see each item's last known location."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FF7809"
      },
      "package": "com.shelf.companion",
      "allowBackup": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "blockedPermissions": ["android.permission.RECORD_AUDIO"],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "category": ["BROWSABLE", "DEFAULT"],
          "data": [
            {
              "scheme": "https",
              "host": "app.shelf.nu",
              "pathPrefix": "/qr/"
            },
            {
              "scheme": "https",
              "host": "app.shelf.nu",
              "pathPrefix": "/assets/"
            },
            {
              "scheme": "https",
              "host": "app.shelf.nu",
              "pathPrefix": "/bookings/"
            },
            {
              "scheme": "https",
              "host": "app.shelf.nu",
              "pathPrefix": "/audits/"
            }
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-dev-client",
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FF7809",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Shelf needs camera access to scan QR codes and barcodes on your assets.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": false
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-quick-actions",
      "./plugins/swift-concurrency-fix",
      "@sentry/react-native",
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "# Expo resolves module and Record classes reflectively from the generated\n# package list, so R8 cannot see those constructors as reachable.\n-keep class expo.modules.** { *; }\n-keep class com.shelf.companion.** { *; }\n\n# React Native marks JNI-reachable members with @DoNotStrip.\n-keepclassmembers class * { @com.facebook.proguard.annotations.DoNotStrip *; }\n-keepclassmembers class * { @com.facebook.react.bridge.ReactMethod *; }\n\n# expo-image references expo.modules.kotlin.runtime.Runtime, which is absent from\n# expo-modules-core. R8 treats a missing class as a hard error, so the reference is\n# suppressed here. The reference is unreachable from our code: nothing calls the\n# Image(Drawable) constructor it sits on.\n-dontwarn expo.modules.kotlin.runtime.**\n"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "b6d6a6cb-c242-4474-815f-b55d5e691c58"
      }
    },
    "owner": "shelfassetmanagement",
    "runtimeVersion": "1.5.0",
    "updates": {
      "url": "https://u.expo.dev/b6d6a6cb-c242-4474-815f-b55d5e691c58",
      "enabled": true,
      "fallbackToCacheTimeout": 0,
      "checkAutomatically": "ON_LOAD"
    }
  }
}
