{
  "name": "@shelf/companion",
  "version": "0.1.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start --dev-client",
    "dev:clear": "expo start --dev-client --clear",
    "sim:env": "node scripts/setup-sim-env.mjs",
    "dev:tunnel": "expo start --dev-client --tunnel",
    "build:ios": "expo run:ios",
    "build:ios:device": "expo run:ios --device",
    "build:android": "expo run:android",
    "prebuild": "expo prebuild",
    "prebuild:clean": "expo prebuild --clean --platform ios",
    "lint": "expo lint && node scripts/check-version-sync.mjs",
    "doctor": "react-doctor .",
    "test": "node --import tsx --test 'lib/**/*.test.ts' 'eslint-local-rules/*.test.cjs'",
    "typecheck": "tsc --noEmit",
    "test:e2e": "cd .maestro/scripts && bash run-all.sh",
    "test:e2e:suite": "cd .maestro/scripts && bash run-suite.sh",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@bwip-js/react-native": "^4.11.4",
    "@expo/metro-runtime": "~58.0.16",
    "@expo/ngrok": "^4.1.3",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "^3.1.0",
    "@react-native-community/datetimepicker": "9.2.1",
    "@react-native-community/netinfo": "12.0.1",
    "@sentry/react-native": "~8.28.0",
    "@shelf/datetime": "workspace:*",
    "@shelf/labels": "workspace:*",
    "@shelf/links": "workspace:*",
    "@shelf/permissions": "workspace:*",
    "@shelf/quantity-control": "workspace:*",
    "@supabase/supabase-js": "^2.49.1",
    "expo": "~58.0.22",
    "expo-audio": "~58.0.11",
    "expo-build-properties": "~58.0.12",
    "expo-camera": "~58.0.14",
    "expo-constants": "~58.0.14",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.18",
    "expo-device": "~58.0.5",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-image": "^58.0.18",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-in-app-updates": "0.12.0",
    "expo-linking": "~58.0.15",
    "expo-location": "~58.0.20",
    "expo-notifications": "~58.1.7",
    "expo-quick-actions": "^6.0.1",
    "expo-router": "~58.0.29",
    "expo-screen-orientation": "~58.0.3",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.12",
    "expo-status-bar": "~58.0.4",
    "expo-store-review": "~58.0.2",
    "expo-updates": "~58.0.20",
    "expo-web-browser": "~58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-calendars": "^1.1314.0",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "^15.16.0",
    "react-native-web": "~0.21.4"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "react-doctor": "0.0.39",
    "tsx": "^4.21.0",
    "typescript": "~6.0.3"
  },
  "expo": {
    "install": {
      "exclude": [
        "@react-native-async-storage/async-storage"
      ]
    },
    "autolinking": {
      "exclude": [
        "react-native-reanimated",
        "react-native-worklets",
        "react-native-gesture-handler"
      ]
    }
  }
}
