@@ -17,6 +17,12 @@ public class ExpoQuickActionsAppDelegate: ExpoAppDelegateSubscriber {
   }
 
   public func application(_ application: UIApplication, performActionFor shortcutItem: UIApplicationShortcutItem, completionHandler: @escaping (Bool) -> Void) {
+    // Under the UIKit scene life cycle a quick action that cold-starts the app
+    // arrives here (forwarded by ExpoAppSceneDelegate) instead of in the launch
+    // options, before JS listens. Keep it as the initial action so JS reads it.
+    if !isObservingQuickActions && initialAction == nil {
+      initialAction = shortcutItem
+    }
     NotificationCenter.default.post(name: Notification.Name(onQuickAction), object: shortcutItem)
     completionHandler(true)
   }
